generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Nota {
  id            Int      @id @default(autoincrement())
  titulo        String
  contenido     String
  creadaEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  @@map("notas")
}

// Historial de las preguntas hechas a Claude, con los tokens que gastó cada una.
model Consulta {
  id           Int      @id @default(autoincrement())
  pregunta     String
  respuesta    String
  inputTokens  Int
  outputTokens Int
  creadaEn     DateTime @default(now())

  @@map("consultas")
}
